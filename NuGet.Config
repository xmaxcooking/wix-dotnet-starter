<?xml version="1.0" encoding="utf-8"?>
<!--
  WixToolset.*, wix, and WixInternal.* packages come from tools/wix-nuget-feed - a local feed of
  WiX v7.0.0 packages self-compiled from https://github.com/wixtoolset/wix (tag v7.0.0) rather
  than downloaded from nuget.org. This avoids the Open Source Maintenance Fee that applies to
  WiX's pre-built NuGet binaries from v6 onward (see OSMFEULA.txt in the WiX repo) - self-compiled
  binaries are explicitly exempt under that EULA's own terms.

  To rebuild this feed (e.g. for a newer WiX version), see tools/wix-nuget-feed/README.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="wix-local" value="tools/wix-nuget-feed" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wix-local">
      <package pattern="WixToolset.*" />
      <package pattern="WixInternal.*" />
      <package pattern="wix" />
    </packageSource>
  </packageSourceMapping>
</configuration>
