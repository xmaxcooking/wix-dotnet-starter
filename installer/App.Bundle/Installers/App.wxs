<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <PackageGroup Id="App">
      <MsiPackage Id="App"
                  SourceFile="$(var.Installer.TargetPath)"
                  Compressed="yes"
                  Permanent="no"
                  Vital="yes" />
    </PackageGroup>
  </Fragment>
</Wix>
