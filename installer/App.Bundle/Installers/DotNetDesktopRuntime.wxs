<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!--
      Prerequisite: .NET 10 Desktop Runtime (x64), needed at runtime since
      App.WinForms is a framework-dependent deployment.

      SourceFile is checked in under Redist\ (see Redist\README.md) - it's a Microsoft
      redistributable that gets a new patch release roughly monthly, so refresh it
      periodically from https://aka.ms/dotnet/10.0/windowsdesktop-runtime-win-x64.exe

      No DetectCondition: the official installer is idempotent and exits quickly
      when the runtime is already present, so this always runs it rather than
      probing the registry for an exact installed version. For a stricter check
      that skips the run entirely when already installed, add a util:RegistrySearch
      (from the WixToolset.Util.wixext package) against
      HKLM\SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App
      and wire its result into DetectCondition - see the WiX util:RegistrySearch docs.
    -->
    <PackageGroup Id="DotNetDesktopRuntime">
      <ExePackage Id="DotNetDesktopRuntime"
                  DisplayName=".NET 10 Desktop Runtime (x64)"
                  SourceFile="Redist\windowsdesktop-runtime-win-x64.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallArguments="/install /quiet /norestart" />
    </PackageGroup>
  </Fragment>
</Wix>
