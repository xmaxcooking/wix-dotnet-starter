<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs as a Burn ExePackage (installer/App.Bundle/Installers/InstallTool.wxs), not an MSI
    custom action, specifically so it CAN target modern .NET - Burn just launches it as a
    normal process, unlike msiexec's custom action host, which only understands .NET
    Framework (see installer/App.Actions). This is the pattern for "I have .NET 10 library
    code that needs to run during install."
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Core\App.Core.csproj" />
  </ItemGroup>

</Project>
