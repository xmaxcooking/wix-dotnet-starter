<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Installer hosts custom action DLLs via the mscoree CLR shim, which only loads .NET Framework assemblies; must stay net48. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" />
  </ItemGroup>

  <!-- Packed into the .CA.dll and extracted next to it at runtime. Without it the native SFXCA host
       has no supportedRuntime hint and loads the legacy CLR 2.0 shim, which can't load this net48
       assembly - throws System.BadImageFormatException. -->
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>

</Project>
