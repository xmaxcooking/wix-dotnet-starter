<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1161</SuppressSpecificWarnings>
    <WixDotnetStarterPackageVersion Condition=" '$(WixDotnetStarterPackageVersion)' == '' ">1.0.0.0</WixDotnetStarterPackageVersion>
    <DefineConstants>$(DefineConstants);WixDotnetStarterPackageVersion=$(WixDotnetStarterPackageVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Installer.Package\App.Installer.Package.wixproj">
      <Name>Installer</Name>
      <DoNotHarvest>True</DoNotHarvest>
    </ProjectReference>

    <ProjectReference Include="..\App.Installer.Tool\App.Installer.Tool.csproj">
      <Name>InstallTool</Name>
      <DoNotHarvest>True</DoNotHarvest>
    </ProjectReference>
  </ItemGroup>

</Project>
