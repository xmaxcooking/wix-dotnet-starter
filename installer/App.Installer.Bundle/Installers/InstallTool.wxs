<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Permanent="yes": a one-shot tool with no persistent footprint, nothing to uninstall. No DetectCondition, so it always runs. -->
    <PackageGroup Id="InstallTool">
      <ExePackage Id="InstallTool"
                  DisplayName="App Install Tool"
                  SourceFile="$(var.InstallTool.TargetDir)$(var.InstallTool.TargetName).exe"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallArguments="&quot;[SampleBundleVariable]&quot;">
        <!-- The apphost exe above is just a native stub; it needs these siblings in the same folder to find and run the managed app. -->
        <Payload SourceFile="$(var.InstallTool.TargetDir)$(var.InstallTool.TargetName).dll" />
        <Payload SourceFile="$(var.InstallTool.TargetDir)$(var.InstallTool.TargetName).deps.json" />
        <Payload SourceFile="$(var.InstallTool.TargetDir)$(var.InstallTool.TargetName).runtimeconfig.json" />
      </ExePackage>
    </PackageGroup>
  </Fragment>
</Wix>
