<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <!-- Some harvested Windows App Runtime DLLs carry an oversized language list in their version
         resource, which ICE03 flags as a File table string overflow - benign, not a real install defect. -->
    <SuppressIces>ICE03</SuppressIces>
    <!-- build/Build.cs passes a per-build WixDotnetStarterPackageVersion for every real build (see
         packageVersion) - this default is only for a plain `dotnet build` outside the Fallout pipeline.
         Folded into DefineConstants locally (not set globally) so it reaches .wxs files as $(var.X)
         without also leaking into every C# ProjectReference's csc invocation as a bogus /define:. -->
    <WixDotnetStarterPackageVersion Condition=" '$(WixDotnetStarterPackageVersion)' == '' ">1.0.0.0</WixDotnetStarterPackageVersion>
    <DefineConstants>$(DefineConstants);WixDotnetStarterPackageVersion=$(WixDotnetStarterPackageVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Client.Windows\App.Client.Windows.csproj">
      <Name>App</Name>
      <DoNotHarvest>True</DoNotHarvest>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
    </ProjectReference>

    <ProjectReference Include="..\App.Installer.Actions\App.Installer.Actions.csproj">
      <Name>Actions</Name>
      <DoNotHarvest>True</DoNotHarvest>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
