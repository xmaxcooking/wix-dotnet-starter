<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Listed explicitly rather than harvested: each Component's Guid must stay stable across builds, or MSI upgrade detection breaks. -->

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <Component Id="App.Client.Windows.exe" Guid="81D2DAB7-9316-4385-8279-E58423E78053">
        <File Id="App.Client.Windows.exe" Source="$(var.App.TargetDir)App.Client.Windows.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="App.Client.Windows Sample"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- WindowsAppSDKSelfContained pulls in dozens of Windows App Runtime DLLs/winmds alongside
           App.Client.Windows's own dependencies; harvest all of it instead of hand-listing each file,
           which previously missed Microsoft.WindowsAppRuntime.dll and left the app unable to start.
           WiX's Files harvester computes each Component's Guid deterministically from its path, so
           these stay stable across rebuilds the same way the Guids above are pinned by hand. -->
      <Files Include="$(var.App.TargetDir)*" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.App.TargetDir)App.Client.Windows.exe" />
        <!-- Debug symbols and XML doc comments are dev-time-only; the running app never reads them. -->
        <Exclude Files="$(var.App.TargetDir)*.pdb" />
        <Exclude Files="$(var.App.TargetDir)*.xml" />
      </Files>

      <Component Id="RemoveStartMenuShortcut" Guid="56A5DCC3-7137-465D-9924-5BCB912EBC4D" Directory="ApplicationProgramsFolder">
        <RemoveFolder Id="CleanUpShortcut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\YourCompany\App.Client.Windows Sample" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
