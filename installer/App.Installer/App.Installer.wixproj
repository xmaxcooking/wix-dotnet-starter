<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.WinForms\App.WinForms.csproj">
      <Name>App</Name>
      <DoNotHarvest>True</DoNotHarvest>
      <RefTargetDir>INSTALLFOLDER</RefTargetDir>
    </ProjectReference>

    <!-- Custom action DLL, embedded into the MSI's Binary table - see CustomActions.wxs. -->
    <ProjectReference Include="..\App.Actions\App.Actions.csproj">
      <Name>Actions</Name>
      <DoNotHarvest>True</DoNotHarvest>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
